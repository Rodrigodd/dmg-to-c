(cell
  sm83_nand2_od_a_dbus
  (inputs in1 in2)

  (outputs y)

  (registers)

  (parameters (L_y 0))

  (assignments

    (t0 (and in1 in2) (delay 0))
    (y
      (bufif1-strength
        0
        t0
        highz1
        strong0
      )
      (delay
        (elmore (wire L_y) (* (nmos 12) 2))
        (elmore (wire L_y) (* (nmos 12) 2))
        (elmore (wire L_y) (* (nmos 12) 2))
      )
    )
  )
)
