(cell
  dmg_muxi
  (inputs d0 d1 sel)

  (outputs y)

  (registers)

  (parameters (L_y 54))

  (assignments

    (sel_n (not sel) (delay (elmore (wire 33) (pmos 6)) (elmore (wire 33) (nmos 6))))
    (mux
      (bufif0-zs d0 sel)
      (delay (elmore (wire 93) (pmos 6)) (elmore (wire 93) (nmos 6)))
    )
    (mux
      (bufif1-sz d0 sel_n)
      (delay (elmore (wire 93) (pmos 6)) (elmore (wire 93) (nmos 6)))
    )
    (mux
      (bufif0-zs d1 sel_n)
      (delay (elmore (wire 93) (pmos 6)) (elmore (wire 93) (nmos 6)))
    )
    (mux
      (bufif1-sz d1 sel)
      (delay (elmore (wire 93) (pmos 6)) (elmore (wire 93) (nmos 6)))
    )
    (mux (keeper) (delay 0))
    (y (not mux) (delay (elmore (wire L_y) (pmos 35)) (elmore (wire L_y) (nmos 35))))
  )
)
