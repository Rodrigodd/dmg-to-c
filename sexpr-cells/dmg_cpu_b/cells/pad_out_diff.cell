(cell
  dmg_pad_out_diff
  (inputs ndrv pdrv_n)

  (outputs pad)

  (registers)

  (parameters (L_pad 0))

  (assignments

    (pad
      (bufif1-sz 0 ndrv)
      (delay (elmore (wire L_pad) (pmos 140)) (elmore (wire L_pad) (nmos 140)))
    )
    (pad
      (bufif0-zs 1 pdrv_n)
      (delay (elmore (wire L_pad) (pmos 140)) (elmore (wire L_pad) (nmos 140)))
    )
  )
)
