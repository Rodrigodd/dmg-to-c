(cell
  dmg_oa21
  (inputs in1 in2 in3)

  (outputs y)

  (registers)

  (parameters (L_y 54))

  (assignments

    (t0 (or in1 in2) (delay 0 (elmore (wire 112) (* (pmos 35) 2))))
    (d0 in3 (delay 0 (elmore (wire 112) (pmos 35))))
    (y
      (and t0 d0)
      (delay
        (+ (elmore (wire 112) (* (nmos 35) 2)) (elmore (wire L_y) (pmos 35)))
        (elmore (wire L_y) (nmos 35))
      )
    )
  )
)
