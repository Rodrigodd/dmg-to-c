    (t1 (not t0) (delay 0))
    (d0 ena_n (delay (elmore (wire 116) (pmos 35)) 0 0))
    (y
      (bufif0 t1 d0)
      (delay
        (+ (elmore (wire 152) (* (nmos 35) 2)) (elmore (wire L_y) (pmos 70)))
        (+ (elmore (wire 125) (* (pmos 35) 2)) (elmore (wire L_y) (nmos 70)))
        (+
          (elmore (wire 116) (nmos 35))
          (elmore (wire 152) (pmos 35))
          (elmore (wire L_y) (pmos 70))
        )
      )
    )
  )
)
