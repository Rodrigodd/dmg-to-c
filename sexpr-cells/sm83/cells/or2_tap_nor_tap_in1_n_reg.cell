(cell
  sm83_or2_tap_nor_tap_in1_n_reg
  (inputs in1 in2)

  (outputs y tap_nor tap_in1_n)

  (registers)

  (parameters (L_y 44) (L_tap_nor 49) (L_tap_in1_n 28))

  (assignments

    (d0 in1 (delay (elmore (wire L_tap_nor) (nmos 9)) 0))
    (d1 in2 (delay (elmore (wire L_tap_nor) (nmos 6)) 0))
    (tap_nor (nor d0 d1) (delay (elmore (wire L_tap_nor) (* (pmos 8) 2)) 0))
    (tap_in1_n
      (not in1)
      (delay (elmore (wire L_tap_in1_n) (pmos 12)) (elmore (wire L_tap_in1_n) (nmos 9)))
    )
    (y (not tap_nor) (delay (elmore (wire L_y) (pmos 12)) (elmore (wire L_y) (nmos 7))))
  )
)
