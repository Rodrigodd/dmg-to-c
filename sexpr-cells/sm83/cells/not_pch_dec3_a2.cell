(cell
  sm83_not_pch_dec3_a2
  (inputs pch_n in)

  (outputs y in)

  (registers)

  (parameters (L_in 27) (L_y 45))

  (assignments

    (y (not in) (delay (elmore (wire L_y) (pmos 15)) (elmore (wire L_y) (nmos 8))))
    (in
      (bufif-zs 1 pch_n)
      (delay
        (elmore (wire L_in) (pmos 8))
        (elmore (wire L_in) (pmos 8))
        (elmore (wire L_in) (pmos 8))
      )
    )
  )
)
