(cell
  sm83_not_x1_pch_dec2
  (inputs pch_n in)

  (outputs y in)

  (registers)

  (parameters (L_in 30) (L_y 30))

  (assignments

    (y (not in) (delay (elmore (wire L_y) (pmos 17)) (elmore (wire L_y) (nmos 8))))
    (in
      (bufif0-strength
        1
        pch_n
        strong1
        highz0
      )
      (delay
        (elmore (wire L_in) (pmos 8))
        (elmore (wire L_in) (pmos 8))
        (elmore (wire L_in) (pmos 8))
      )
    )
  )
)
