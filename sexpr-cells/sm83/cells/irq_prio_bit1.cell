(cell
  sm83_irq_prio_bit1
  (inputs
    pch_n
    and_in1
    and_in2_nand_a_in2
    nand_b_in2
    nand_b_in3
    dist_nand_a_in
    dist_nand_b_in
    dist_nor_in
    dist_nand_a_in_n
    dist_nand_b_in_n
    dist_nor_in_p
  )

  (outputs
    nand_a_y
    nand_b_y
    nand_c_y
    dist_nand_a_y_n
    dist_nand_a_y_p
    dist_nand_b_y_n
    dist_nand_b_y_p
    dist_nor_y_n
    dist_nor_y_p
    and_y
  )

  (registers)

  (parameters
    (L_and_y 75)
    (L_nand_a_y 89)
    (L_nand_b_y 0)
    (L_nand_c_y 43)
    (L_dist_nand_a_y_n 0)
    (L_dist_nand_a_y_p 74)
    (L_dist_nand_b_y_n 56)
    (L_dist_nand_b_y_p 74)
    (L_dist_nor_y_n 74)
    (L_dist_nor_y_p 31)
  )

  (assignments

    (and_y
      (and and_in1 and_in2_nand_a_in2)
      (delay
        (+ (elmore (wire 24) (* (nmos 3.0) 2)) (elmore (wire L_and_y) (pmos 14.5)))
        (+ (elmore (wire 24) (pmos 3.0)) (elmore (wire L_and_y) (nmos 8.0)))
      )
    )
    (t0 (and pch_n and_in2_nand_a_in2) (delay 0))
    (nand_a_y
      (bufif-sz 0 t0)
      (delay
        (elmore (wire L_nand_a_y) (* (nmos 6) 2))
        (elmore (wire L_nand_a_y) (* (nmos 6) 2))
        (elmore (wire L_nand_a_y) (* (nmos 6) 2))
      )
    )
    (t1 (and pch_n nand_b_in2 nand_b_in3) (delay 0))
    (nand_b_y
      (bufif-sz 0 t1)
      (delay
        (elmore (wire L_nand_b_y) (* (nmos 6) 3))
        (elmore (wire L_nand_b_y) (* (nmos 6) 3))
        (elmore (wire L_nand_b_y) (* (nmos 6) 3))
      )
    )
    (t2 (and pch_n and_y) (delay 0))
    (nand_c_y
      (bufif-sz 0 t2)
      (delay
        (elmore (wire L_nand_c_y) (* (nmos 6) 2))
        (elmore (wire L_nand_c_y) (* (nmos 6) 2))
        (elmore (wire L_nand_c_y) (* (nmos 6) 2))
      )
    )
    (dist_nand_a_y_p
      (bufif-zs 1 dist_nand_a_in)
      (delay
        (elmore (wire L_dist_nand_a_y_p) (pmos 3))
        (elmore (wire L_dist_nand_a_y_p) (pmos 3))
        (elmore (wire L_dist_nand_a_y_p) (pmos 3))
      )
    )
    (t3 (caseneq dist_nand_a_in_n 1) (delay 0))
    (t4 (and dist_nand_a_in t3) (delay 0))
    (dist_nand_a_y_n
      (nmos dist_nand_a_in_n t4)
      (delay
        (elmore (wire L_dist_nand_a_y_n) (nmos 3))
        (elmore (wire L_dist_nand_a_y_n) (nmos 3))
        (elmore (wire L_dist_nand_a_y_n) (nmos 3))
      )
    )
    (dist_nand_b_y_p
      (bufif-zs 1 dist_nand_b_in)
      (delay
        (elmore (wire L_dist_nand_b_y_p) (pmos 3))
        (elmore (wire L_dist_nand_b_y_p) (pmos 3))
        (elmore (wire L_dist_nand_b_y_p) (pmos 3))
      )
    )
    (t5 (caseneq dist_nand_b_in_n 1) (delay 0))
    (t6 (and dist_nand_b_in t5) (delay 0))
    (dist_nand_b_y_n
      (nmos dist_nand_b_in_n t6)
      (delay
        (elmore (wire L_dist_nand_b_y_n) (nmos 3))
        (elmore (wire L_dist_nand_b_y_n) (nmos 3))
        (elmore (wire L_dist_nand_b_y_n) (nmos 3))
      )
    )
    (t7 (caseeq dist_nor_in_p 0) (delay 0))
    (t8 (or dist_nor_in t7) (delay 0))
    (dist_nor_y_p
      (pmos dist_nor_in_p t8)
      (delay
        (elmore (wire L_dist_nor_y_p) (pmos 5))
        (elmore (wire L_dist_nor_y_p) (pmos 5))
        (elmore (wire L_dist_nor_y_p) (pmos 5))
      )
    )
    (dist_nor_y_n
      (bufif-sz 0 dist_nor_in)
      (delay
        (elmore (wire L_dist_nor_y_n) (nmos 3))
        (elmore (wire L_dist_nor_y_n) (nmos 3))
        (elmore (wire L_dist_nor_y_n) (nmos 3))
      )
    )
  )
)
