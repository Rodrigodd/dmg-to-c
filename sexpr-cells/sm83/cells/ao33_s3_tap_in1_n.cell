(cell
  sm83_ao33_s3_tap_in1_n
  (inputs
    in1
    in2
    in3
    in4
    in5
  )

  (outputs y tap_in1_n)

  (registers)

  (assignments

    (d0 in1 (delay 0 (elmore (wire 14) (* (pmos 3) 2))))
    (d1 in2 (delay 0 (elmore (wire 14) (* (pmos 3) 2))))
    (d4 in3 (delay 0 (elmore (wire 14) (pmos 3))))
    (t0 (and d0 d1 d4) (delay 0))
    (d2 in4 (delay 0 (elmore (wire 14) (* (pmos 3) 2))))
    (d3 in5 (delay 0 (elmore (wire 14) (* (pmos 3) 2))))
    (d5 in3 (delay 0 (elmore (wire 14) (pmos 3))))
    (t1 (and d2 d3 d5) (delay 0))
    (y
      (or t0 t1)
      (delay
        (+ (elmore (wire 14) (* (nmos 3) 3)) (elmore (wire L_y) (pmos 3)))
        (elmore (wire L_y) (nmos 3))
      )
    )
    (tap_in1_n
      (not in1)
      (delay (elmore (wire L_tap_in1_n) (pmos 4)) (elmore (wire L_tap_in1_n) (nmos 4)))
    )
  )
)
