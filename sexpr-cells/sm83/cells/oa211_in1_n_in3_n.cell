(cell
  sm83_oa211_in1_n_in3_n
  (inputs
    in1_n
    in2
    in3_n
    in4
  )

  (outputs y)

  (registers)

  (assignments

    (t0
      (not in1_n)
      (delay
        (+ (elmore (wire 42) (* (pmos 3) 2)) (elmore (wire 15) (nmos 3)))
        (elmore (wire 42) (nmos 3))
      )
    )
    (d1 in2 (delay (elmore (wire 15) (* (nmos 3) 2)) 0))
    (t1 (or t0 d1) (delay 0))
    (t2
      (not in3_n)
      (delay
        (+ (elmore (wire 42) (* (pmos 3) 2)) (elmore (wire 15) (* (nmos 3) 2)))
        (elmore (wire 42) (nmos 3))
      )
    )
    (d0 in4 (delay (elmore (wire 15) (* (nmos 3) 2)) 0))
    (y
      (and t1 t2 d0)
      (delay
        (elmore (wire L_y) (pmos 16))
        (+ (elmore (wire 15) (* (pmos 3) 2)) (elmore (wire L_y) (nmos 8)))
      )
    )
  )
)
