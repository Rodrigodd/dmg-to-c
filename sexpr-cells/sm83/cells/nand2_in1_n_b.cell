(cell
  sm83_nand2_in1_n_b
  (inputs in1_n in2)

  (outputs y)

  (registers)

  (parameters (L_y 14))

  (assignments

    (t0 (not in1_n) (delay (elmore (wire 19) (pmos 3)) (elmore (wire 19) (nmos 3))))
    (y (nand t0 in2) (delay (elmore (wire L_y) (pmos 3)) (elmore (wire L_y) (* (nmos 3) 2))))
  )
)
