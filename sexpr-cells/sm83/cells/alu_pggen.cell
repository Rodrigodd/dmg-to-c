(cell
  sm83_alu_pggen
  (inputs
    xor_in1
    xor_in2
    and_or_in2
    ao221_in2
    ao221_in3
    pch_n
    ao221_in5_n
  )

  (outputs
    tap_xor
    tap_nand
    tap_and
    tap_or
    y
    ao221_in5_n
  )

  (registers)

  (parameters
    (L_ao221_in5_n 74)
    (L_tap_xor 54)
    (L_tap_nand 84)
    (L_tap_and 58)
    (L_tap_or 83)
    (L_y 23)
  )

  (assignments

    (tap_xor
      (xor xor_in1 xor_in2)
      (delay
        (+
          (elmore (wire 31) (pmos 5))
          (elmore (wire 28) (* (nmos 5) 2))
          (elmore (wire L_tap_xor) (pmos 15))
        )
        (+
          (elmore (wire 31) (* (nmos 5) 2))
          (elmore (wire 28) (* (pmos 5) 2))
          (elmore (wire L_tap_xor) (nmos 8))
        )
      )
    )
    (d0 (nand tap_xor and_or_in2) (delay 0 (elmore (wire L_tap_nand) (* (nmos 5) 2))))
    (tap_nand d0 (delay (elmore (wire L_tap_nand) (pmos 5)) 0))
    (d1 (not d0) (delay (elmore (wire L_tap_and) (pmos 15)) 0))
    (tap_and
      d1
      (delay 0 (+ (elmore (wire L_tap_nand) (pmos 5)) (elmore (wire L_tap_and) (nmos 8))))
    )
    (d2
      (or tap_xor and_or_in2)
      (delay 0 (+ (elmore (wire 29) (* (pmos 5) 2)) (elmore (wire L_tap_or) (nmos 8))))
    )
    (tap_or d2 (delay (+ (elmore (wire 29) (nmos 5)) (elmore (wire L_tap_or) (pmos 15))) 0))
    (d3 d1 (delay 0 (+ (elmore (wire 29) (* (pmos 5) 2)) (elmore (wire L_tap_or) (nmos 8)))))
    (t0 (and d3 ao221_in2) (delay (elmore (wire 32) (* (nmos 5) 2)) (elmore (wire 32) (pmos 5))))
    (d4
      d2
      (delay (+ (elmore (wire L_tap_nand) (* (nmos 5) 2)) (elmore (wire L_tap_and) (pmos 15))) 0)
    )
    (t1 (and ao221_in3 d4) (delay (elmore (wire 32) (* (nmos 5) 2)) (elmore (wire 32) (pmos 5))))
    (t2 (not ao221_in5_n) (delay 0))
    (y (or t0 t1 t2) (delay (elmore (wire L_y) (pmos 5)) (elmore (wire L_y) (* (nmos 5) 3))))
    (ao221_in5_n
      (bufif0-strength
        1
        pch_n
        strong1
        highz0
      )
      (delay
        (elmore (wire L_ao221_in5_n) (pmos 5))
        (elmore (wire L_ao221_in5_n) (pmos 5))
        (elmore (wire L_ao221_in5_n) (pmos 5))
      )
    )
  )
)
