(cell
  sm83_not_pch_x2_alu
  (inputs pch_n in)

  (outputs y in)

  (registers)

  (parameters (L_in 54) (L_y 54))

  (assignments

    (y (not in) (delay (elmore (wire L_y) (pmos 15)) (elmore (wire L_y) (nmos 4))))
    (in
      (bufif0-zs 1 pch_n)
      (delay
        (elmore (wire L_in) (pmos 8))
        (elmore (wire L_in) (pmos 8))
        (elmore (wire L_in) (pmos 8))
      )
    )
  )
)
