(cell
  sm83_oai21
  (inputs in1 in2 in3)

  (outputs y)

  (registers)

  (parameters (L_y 34))

  (assignments

    (t0 (or in1 in2) (delay 0 (elmore (wire L_y) (* (pmos 3) 2))))
    (d0 in3 (delay 0 (elmore (wire L_y) (pmos 3))))
    (y (nand t0 d0) (delay 0 (elmore (wire L_y) (* (nmos 3) 2))))
  )
)
