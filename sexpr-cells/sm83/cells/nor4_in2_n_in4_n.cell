(cell
  sm83_nor4_in2_n_in4_n
  (inputs
    in1
    in2_n
    in3
    in4_n
  )

  (outputs y)

  (registers)

  (assignments

    (t0 (not in2_n) (delay (elmore (wire 47) (pmos 3)) (elmore (wire 47) (nmos 3))))
    (t1 (not in4_n) (delay (elmore (wire 35) (pmos 3)) (elmore (wire 35) (nmos 3))))
    (y
      (nor
        in1
        t0
        in3
        t1
      )
      (delay (elmore (wire L_y) (* (pmos 3) 2)) (elmore (wire L_y) (nmos 3)))
    )
  )
)
