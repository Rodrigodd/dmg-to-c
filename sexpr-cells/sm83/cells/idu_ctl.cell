(cell
  sm83_idu_ctl
  (inputs
    in1
    in2
    in3
    in4
    in5
  )

  (outputs y1 y2 y3)

  (registers)

  (parameters (L_y1 24) (L_y2 36) (L_y3 40))

  (assignments

    (t0
      (not in4)
      (delay
        (+ (elmore (wire 25) (pmos 3)) (elmore (wire 68) (* (nmos 5) 3)))
        (+ (elmore (wire 25) (nmos 3)) (elmore (wire 68) (pmos 5)))
      )
    )
    (d2
      in2
      (delay
        (+ (elmore (wire 34) (pmos 3)) (elmore (wire 92) (* (nmos 5) 3)))
        (+ (elmore (wire 34) (nmos 3)) (elmore (wire 92) (pmos 5)))
      )
    )
    (d3 in3 (delay (elmore (wire 92) (* (nmos 5) 3)) (elmore (wire 92) (pmos 5))))
    (t1 (and d3 t0 d2) (delay 0))
    (t2
      (not in2)
      (delay
        (+ (elmore (wire 34) (pmos 3)) (elmore (wire 92) (* (nmos 5) 3)))
        (+ (elmore (wire 34) (nmos 3)) (elmore (wire 92) (pmos 5)))
      )
    )
    (d4 in3 (delay (elmore (wire 92) (* (nmos 5) 3)) (elmore (wire 92) (pmos 5))))
    (d5
      in4
      (delay
        (+ (elmore (wire 25) (pmos 3)) (elmore (wire 68) (* (nmos 5) 3)))
        (+ (elmore (wire 25) (nmos 3)) (elmore (wire 68) (pmos 5)))
      )
    )
    (t3 (and d4 d5 t2) (delay 0))
    (y1 (or t1 t3) (delay (elmore (wire L_y1) (pmos 7)) (elmore (wire L_y1) (* (nmos 7) 2))))
    (t4 (not in4) (delay (elmore (wire 25) (pmos 3)) (elmore (wire 25) (nmos 3))))
    (t5 (and in3 t4 in2) (delay (elmore (wire 68) (* (nmos 5) 3)) (elmore (wire 68) (pmos 5))))
    (d0 in1 (delay (elmore (wire 19) (nmos 3)) (elmore (wire 19) (pmos 3))))
    (y2 (or t5 d0) (delay (elmore (wire L_y2) (pmos 7)) (elmore (wire L_y2) (* (nmos 7) 2))))
    (t6 (not in2) (delay (elmore (wire 34) (pmos 3)) (elmore (wire 34) (nmos 3))))
    (t7 (and in3 in4 t6) (delay (elmore (wire 92) (* (nmos 5) 3)) (elmore (wire 92) (pmos 5))))
    (d1 in5 (delay (elmore (wire 18) (nmos 3)) (elmore (wire 18) (pmos 3))))
    (y3 (or d1 t7) (delay (elmore (wire L_y3) (pmos 7)) (elmore (wire L_y3) (* (nmos 7) 2))))
  )
)
