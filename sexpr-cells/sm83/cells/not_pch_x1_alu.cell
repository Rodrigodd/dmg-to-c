(cell
  sm83_not_pch_x1_alu
  (inputs pch_n in)

  (outputs y in)

  (registers)

  (parameters (L_in 46) (L_y 45))

  (assignments

    (y (not in) (delay (elmore (wire L_y) (pmos 15)) (elmore (wire L_y) (nmos 5))))
    (in
      (bufif0-zs 1 pch_n)
      (delay
        (elmore (wire L_in) (pmos 3))
        (elmore (wire L_in) (pmos 3))
        (elmore (wire L_in) (pmos 3))
      )
    )
  )
)
