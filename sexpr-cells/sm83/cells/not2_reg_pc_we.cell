(cell
  sm83_not2_reg_pc_we
  (inputs a_in b_in)

  (outputs a_y b_y)

  (registers)

  (parameters (L_a_y 27) (L_b_y 56))

  (assignments

    (a_y (not a_in) (delay (elmore (wire L_a_y) (pmos 15.0)) (elmore (wire L_a_y) (nmos 9.0))))
    (b_y (not b_in) (delay (elmore (wire L_b_y) (pmos 4.5)) (elmore (wire L_b_y) (nmos 4.5))))
  )
)
