(cell
  sm83_mux_idu_h
  (inputs d0 d1 sel)

  (outputs y)

  (registers)

  (parameters (L_y 30))

  (assignments

    (d2 sel (delay (elmore (wire 33) (pmos 3)) (elmore (wire 33) (nmos 3))))
    (y
      (mux d2 d1 d0)
      (delay
        (+ (elmore (wire 28) (* (nmos 3) 2)) (elmore (wire L_y) (pmos 13)))
        (+ (elmore (wire 28) (* (pmos 3) 2)) (elmore (wire L_y) (nmos 5)))
      )
    )
  )
)
