(cell
  sm83_reg_bus_pch_a_bit0123
  (inputs
    pch_n
    c_zero
    b_y
    c_y
  )

  (outputs
    a_y
    b_y_n
    c_y_n
    b_y
    c_y
  )

  (registers)

  (parameters
    (L_a_y 67)
    (L_b_y 79)
    (L_b_y_n 54)
    (L_c_y 73)
    (L_c_y_n 54)
  )

  (assignments

    (b_y_n (not b_y) (delay (elmore (wire L_b_y_n) (pmos 15)) (elmore (wire L_b_y_n) (nmos 5))))
    (c_y_n (not c_y) (delay (elmore (wire L_c_y_n) (pmos 15)) (elmore (wire L_c_y_n) (nmos 8))))
    (a_y
      (bufif-zs 1 pch_n)
      (delay
        (elmore (wire L_a_y) (pmos 10))
        (elmore (wire L_a_y) (pmos 10))
        (elmore (wire L_a_y) (pmos 10))
      )
    )
    (b_y
      (bufif-zs 1 pch_n)
      (delay
        (elmore (wire L_b_y) (pmos 15))
        (elmore (wire L_b_y) (pmos 15))
        (elmore (wire L_b_y) (pmos 15))
      )
    )
    (c_y
      (bufif-zs 1 pch_n)
      (delay
        (elmore (wire L_c_y) (pmos 15))
        (elmore (wire L_c_y) (* (nmos 8) 2))
        (elmore (wire L_c_y) (pmos 15))
      )
    )
    (t0 (and pch_n c_zero) (delay 0))
    (c_y
      (bufif1 0 t0)
      (delay
        (elmore (wire L_c_y) (pmos 15))
        (elmore (wire L_c_y) (* (nmos 8) 2))
        (elmore (wire L_c_y) (pmos 15))
      )
    )
  )
)
