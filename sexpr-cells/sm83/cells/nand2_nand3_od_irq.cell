(cell
  sm83_nand2_nand3_od_irq
  (inputs
    a_in1
    a_in2
    b_in1
    b_in2
    b_in3
  )

  (outputs a_y b_y)

  (registers)

  (parameters (L_a_y 44) (L_b_y 69))

  (assignments

    (a_y
      (nand a_in1 a_in2)
      (delay (elmore (wire L_a_y) (pmos 3)) (elmore (wire L_a_y) (* (nmos 3) 2)))
    )
    (t0 (and b_in1 b_in2 b_in3) (delay 0))
    (b_y
      (bufif1-sz 0 t0)
      (delay
        (elmore (wire L_b_y) (* (nmos 9) 3))
        (elmore (wire L_b_y) (* (nmos 9) 3))
        (elmore (wire L_b_y) (* (nmos 9) 3))
      )
    )
  )
)
