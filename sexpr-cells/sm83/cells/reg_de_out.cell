(cell
  sm83_reg_de_out
  (inputs
    ena1
    d_ena2
    e_ena2
    d_in
    e_in
    d_zero1
    d_zero2
  )

  (outputs d_y1 e_y1 y2)

  (registers)

  (parameters (L_d_y1 61) (L_e_y1 89) (L_y2 88))

  (assignments

    (t0 (and ena1 d_in) (delay 0))
    (d_y1
      (bufif1-sz 0 t0)
      (delay
        (elmore (wire L_d_y1) (* (nmos 8) 2))
        (elmore (wire L_d_y1) (* (nmos 8) 2))
        (elmore (wire L_d_y1) (* (nmos 8) 2))
      )
    )
    (t1 (or d_zero1 d_zero2) (delay 0))
    (d_y1
      (bufif1-sz 0 t1)
      (delay
        (elmore (wire L_d_y1) (* (nmos 8) 2))
        (elmore (wire L_d_y1) (nmos 10))
        (elmore (wire L_d_y1) (* (nmos 8) 2))
      )
    )
    (t2 (and ena1 e_in) (delay 0))
    (e_y1
      (bufif1-sz 0 t2)
      (delay
        (elmore (wire L_e_y1) (* (nmos 8) 2))
        (elmore (wire L_e_y1) (* (nmos 8) 2))
        (elmore (wire L_e_y1) (* (nmos 8) 2))
      )
    )
    (t3 (and d_ena2 d_in) (delay 0))
    (t4 (and e_ena2 e_in) (delay 0))
    (t5 (or t3 t4) (delay 0))
    (y2
      (bufif1-sz 0 t5)
      (delay
        (elmore (wire L_y2) (* (nmos 8) 2))
        (elmore (wire L_y2) (* (nmos 8) 2))
        (elmore (wire L_y2) (* (nmos 8) 2))
      )
    )
  )
)
