(cell
  sm83_aoi21_a
  (inputs in1 in2 in3)

  (outputs y)

  (registers)

  (parameters (L_y 22))

  (assignments

    (t0 (and in1 in2) (delay (elmore (wire L_y) (* (nmos 3) 2)) 0))
    (d0 in3 (delay (elmore (wire L_y) (nmos 3)) 0))
    (y (nor t0 d0) (delay (elmore (wire L_y) (* (pmos 3) 2)) 0))
  )
)
