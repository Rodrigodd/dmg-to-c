(cell
  sm83_mux_idu_l
  (inputs d0 d1 sel)

  (outputs y)

  (registers)

  (parameters (L_y 37))

  (assignments

    (d2 sel (delay (elmore (wire 31) (pmos 3)) (elmore (wire 31) (nmos 3))))
    (y
      (mux d2 d1 d0)
      (delay
        (+ (elmore (wire 36) (* (nmos 3) 2)) (elmore (wire L_y) (pmos 10)))
        (+ (elmore (wire 36) (* (pmos 3) 2)) (elmore (wire L_y) (nmos 5)))
      )
    )
  )
)
